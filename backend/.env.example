# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
# MUST be the secret / service_role key (sb_secret_...). The backend enforces
# access control itself and needs to read across nurses to hand a patient over.
# Never ship this to the client — the publishable key goes in frontend/.env.
SUPABASE_SECRET_KEY=sb_secret_...

# Voice and AI (optional: without these the app runs and nurses type their notes)
# Groq: English transcription, autocorrect and handoff summaries
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3-turbo
# Sarvam: Hindi transcription
SARVAM_API_KEY=sk_...
SARVAM_STT_MODEL=saaras:v3

# Comma-separated CORS origins
ALLOWED_ORIGINS=http://localhost:1420,http://localhost:5173,tauri://localhost
